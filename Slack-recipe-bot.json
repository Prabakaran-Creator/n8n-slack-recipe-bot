    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\n\n// Convert \"- item\" lines to Slack bullets and tidy whitespace\nconst message = raw\n  .trim()\n  .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')   // markdown bold -> Slack bold\n  .replace(/^\\s*[-*]\\s+/gm, '• ')      // bullets\n  .replace(/\\n{3,}/g, '\\n\\n');         // remove extra blank lines\n\nreturn [{ json: { message } }];"
      },
